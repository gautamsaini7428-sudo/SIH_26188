# Backend API Base URL
# Leave blank (or omit) during local development to use Vite's internal proxy (http://localhost:5173 -> http://127.0.0.1:8000)
# When running a public demo with Cloudflare Quick Tunnels, set this to your backend tunnel URL:
# VITE_API_URL=https://your-backend-subdomain.trycloudflare.com
VITE_API_URL=
